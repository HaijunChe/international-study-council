# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty in development: the kernel then boots an embedded
# Postgres (PGlite) that persists to ./.data/pg. Set it in production.
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# --- Auth -----------------------------------------------------------------
# 32+ random chars. Used to sign admin session cookies.
AUTH_SECRET=change-me-to-a-long-random-string

# --- Media ----------------------------------------------------------------
# Optional. Without it uploads land in ./public/uploads (dev only).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# --- First admin account (used only when the users table is empty) ---------
SEED_ADMIN_EMAIL=admin@internationalstudycouncil.com
SEED_ADMIN_PASSWORD=changeme123
